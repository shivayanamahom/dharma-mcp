<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field name="search" type="text"
			label="JSEARCH_FILTER"
			hint="JSEARCH_FILTER"
			class="js-stools-search-string" />

		<field name="status" type="list"
			label="COM_DHARMASHOP_MCP_LOG_STATUS"
			onchange="this.form.submit();">
			<option value="">- Выберите статус -</option>
			<option value="ok">ok</option>
			<option value="error">error</option>
			<option value="confirmation_required">confirmation_required</option>
		</field>
	</fields>

	<fields name="list">
		<field name="fullordering" type="list"
			label="JGLOBAL_SORT_BY"
			default="a.id DESC"
			onchange="this.form.submit();">
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
			<option value="a.duration_ms ASC">COM_DHARMASHOP_MCP_LOG_DURATION_ASC</option>
			<option value="a.duration_ms DESC">COM_DHARMASHOP_MCP_LOG_DURATION_DESC</option>
		</field>

		<field name="limit" type="limitbox"
			label="JGLOBAL_LIST_LIMIT"
			default="25"
			onchange="this.form.submit();" />
	</fields>
</form>
