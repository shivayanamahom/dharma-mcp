	<creationDate>2026-10</creationDate>
	<author>Dharma</author>
	<copyright>(C) 2026 Dharma. Все права защищены.</copyright>
	<license>GNU General Public License версии 2 или новее; см. LICENSE.txt</license>
	<version>0.6.4</version>
	<description>PKG_DHARMA_MCP_XML_DESCRIPTION</description>
	<scriptfile>script.php</scriptfile>

	<files>
		<file type="component" id="com_dharma_mcp">com_dharma_mcp.zip</file>
		<file type="plugin" id="dharmamcp" group="system">plg_system_dharmamcp.zip</file>
		<file type="plugin" id="shop" group="dharmamcp">plg_dharmamcp_shop.zip</file>
